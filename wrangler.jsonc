{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend-sistema-integracion-empleados-fastapi",
  "main": "src/worker.py",
  "compatibility_date": "2025-11-02",
  "compatibility_flags": [
    "python_workers",
    "python_dedicated_snapshot"
  ],
  "vars": {
    "MESSAGE": "My env var",
    "CF_AI_TOKEN": "tu_token_de_cloudflare",
    "CF_ACCOUNT_ID": "tu_account_id_de_cloudflare",
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "dataBase",
      "database_name": "integracion_empleados_data_base",
      "database_id": "96602da8-f6bb-4cc1-805f-d47f96f09565",
    },
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "secrets_store_secrets": [
    {
      "binding": "resend",
      "store_id": "29806d0257da4c6e996ae6340e9153c2",
      "secret_name": "emailresend",
    },
    {
      "binding": "mailjet_private_key",
      "store_id": "29806d0257da4c6e996ae6340e9153c2",
      "secret_name": "mailjetprivate",
    },
    {
      "binding": "mailjet_public_key",
      "store_id": "29806d0257da4c6e996ae6340e9153c2",
      "secret_name": "mailjetpublic",
    },
    {
      "binding": "JWTSecret",
      "store_id": "29806d0257da4c6e996ae6340e9153c2",
      "secret_name": "JWTSecret",
    },
    {
      "binding": "MAILJET_FROM_EMAIL",
      "store_id": "29806d0257da4c6e996ae6340e9153c2",
      "secret_name": "MAILJET_FROM_EMAIL",
    },
    {
      "binding": "token_ia",
      "store_id": "29806d0257da4c6e996ae6340e9153c2",
      "secret_name": "token_ia",
    }
  ]
}